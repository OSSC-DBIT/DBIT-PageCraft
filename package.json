{
  "name": "dbit-pagecraft",
  "version": "2.0.0",
  "private": true,
  "description": "DBIT/VTU academic document generator - self-hosted PWA with a small Node.js + PostgreSQL backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
