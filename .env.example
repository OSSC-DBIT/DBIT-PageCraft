# DBIT PageCraft - Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.
# docker compose reads this file automatically.
# One .env per environment on the server (staging / production), see docs/DEPLOYMENT.md
# -----------------------------------------------------------------------------

# -- Environment identity -----------------------------------------------------
# Compose project name: isolates containers, network and volumes per environment.
COMPOSE_PROJECT_NAME=pagecraft
# production | staging | development  (non-production adds X-Robots-Tag: noindex)
APP_ENV=development
# Enable the Cloudflare Tunnel connector by setting:  COMPOSE_PROFILES=tunnel
COMPOSE_PROFILES=

# -- Cloudflare Tunnel (only when COMPOSE_PROFILES=tunnel) --------------------
# Zero Trust > Networks > Tunnels > your tunnel > connector token.
# Public hostname in the tunnel must point to:  http://nginx:80
CF_TUNNEL_TOKEN=

# -- PostgreSQL (used by the db container and to build DATABASE_URL) ----------
POSTGRES_DB=pagecraft
POSTGRES_USER=pagecraft
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Only needed when running `npm run dev` outside Docker:
# DATABASE_URL=postgres://pagecraft:change-me-to-a-long-random-password@localhost:5432/pagecraft

# -- Admin dashboard (/admin) -------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random string of at least 32 characters, used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_HOURS=8

# -- Ports on the host --------------------------------------------------------
# With Cloudflare Tunnel nothing has to be public. nginx is bound to loopback for
# local checks only. Use different ports per environment on a shared server:
#   staging:    HTTP_PORT=8081  APP_PORT=3001
#   production: HTTP_PORT=8080  APP_PORT=3000
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_PORT=3000
# Only used with docker-compose.tls.yml (direct public exposure without the tunnel)
HTTPS_PORT=443

# -- Proxy / cookies ----------------------------------------------------------
# nginx rewrites X-Forwarded-For to the real client IP (CF-Connecting-IP aware),
# so the app trusts exactly one hop. Leave at 1.
TRUST_PROXY=1
# Force the Secure flag on the session cookie: true | false | blank = auto.
# Behind Cloudflare the scheme is detected as https automatically; set true in
# production anyway so the admin cookie can never be sent over plain http.
COOKIE_SECURE=

# -- Set automatically by deploy/deploy.sh on servers (do not edit by hand) ---
# APP_IMAGE=ghcr.io/ossc-dbit/dbit-pagecraft:<git sha>
# APP_VERSION=<git sha>
