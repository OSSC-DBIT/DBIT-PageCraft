# DBIT PageCraft - Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.
# docker compose reads this file automatically.
# -----------------------------------------------------------------------------

# -- PostgreSQL (used by the db container and to build DATABASE_URL) ----------
POSTGRES_DB=pagecraft
POSTGRES_USER=pagecraft
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Only needed when running `npm run dev` outside Docker:
# DATABASE_URL=postgres://pagecraft:change-me-to-a-long-random-password@localhost:5432/pagecraft

# -- Admin dashboard (/admin) -------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random string of at least 32 characters, used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_HOURS=8

# -- Ports published on the host ----------------------------------------------
HTTP_PORT=80          # nginx
HTTPS_PORT=443        # nginx (only used once nginx/conf.d/tls.conf exists)
APP_PORT=3000         # Node app, bound to 127.0.0.1 only (debugging)

# -- Proxy / cookies ----------------------------------------------------------
# 1 = trust X-Forwarded-* from the nginx container (default in docker compose).
# Set to 2 if there is another proxy (e.g. Cloudflare) in front of nginx.
TRUST_PROXY=1

# Force the Secure flag on the session cookie: true | false | blank = auto (https)
COOKIE_SECURE=
